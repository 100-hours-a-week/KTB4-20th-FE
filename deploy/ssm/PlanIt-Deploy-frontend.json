{
  "schemaVersion": "2.2",
  "description": "Deploy frontend using the existing Docker Compose service",
  "parameters": {
    "imageDigest": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deploy",
      "inputs": {
        "timeoutSeconds": "1200",
        "runCommand": [
          "bash <<'BASH'",
          "set -euo pipefail",
          "umask 077",
          "",
          "cd /home/ubuntu/planit",
          "REGISTRY=577483323183.dkr.ecr.ap-northeast-2.amazonaws.com",
          "[[ \"$SSM_imageDigest\" =~ ^sha256:[0-9a-f]{64}$ ]]",
          "IMAGE=\"$REGISTRY/planit/frontend@$SSM_imageDigest\"",
          "",
          "install -d -m 700 /opt/planit/state",
          "exec 9>/opt/planit/state/deploy.lock",
          "flock -w 120 9",
          "",
          "COMPOSE=(docker compose --env-file .env -f compose.yaml)",
          "\"${COMPOSE[@]}\" config --quiet",
          "test -d /opt/planit/assets",
          "",
          "BACKUP=$(mktemp -d /opt/planit/state/frontend-backup.XXXXXX)",
          "cp -p .env \"$BACKUP/env\"",
          "docker inspect planit-frontend-1 --format '{{.Config.Image}}' > \"$BACKUP/previous-image.txt\"",
          "echo \"Recovery files: $BACKUP\"",
          "",
          "aws ecr get-login-password --region ap-northeast-2 | docker login --username AWS --password-stdin \"$REGISTRY\"",
          "timeout 240 docker pull \"$IMAGE\"",
          "",
          "STAGE=$(mktemp -d)",
          "TEMP_CONTAINER=",
          "cleanup() {",
          "  if [ -n \"$TEMP_CONTAINER\" ]; then",
          "    docker rm \"$TEMP_CONTAINER\" >/dev/null 2>&1 || true",
          "  fi",
          "  rm -rf \"$STAGE\"",
          "}",
          "trap cleanup EXIT",
          "",
          "TEMP_CONTAINER=$(docker create \"$IMAGE\")",
          "docker cp \"$TEMP_CONTAINER:/usr/share/nginx/html/assets/.\" \"$STAGE/\"",
          "",
          "python3 - \"$STAGE\" <<'PY'",
          "import shutil",
          "import sys",
          "from pathlib import Path",
          "",
          "source = Path(sys.argv[1])",
          "target = Path('/opt/planit/assets')",
          "files = list(source.rglob('*'))",
          "if not any(p.is_file() for p in files):",
          "    raise SystemExit('Frontend assets are empty')",
          "for path in files:",
          "    if path.is_symlink():",
          "        raise SystemExit('Asset symlinks are unsupported')",
          "    if not path.is_file():",
          "        continue",
          "    dest = target / path.relative_to(source)",
          "    if dest.exists():",
          "        if dest.read_bytes() != path.read_bytes():",
          "            raise SystemExit('Asset filename collision')",
          "        continue",
          "    dest.parent.mkdir(parents=True, exist_ok=True)",
          "    parent = dest.parent",
          "    while parent != target.parent:",
          "        parent.chmod(0o755)",
          "        parent = parent.parent",
          "    shutil.copyfile(path, dest)",
          "    dest.chmod(0o644)",
          "PY",
          "",
          "export FE_IMAGE=\"$IMAGE\"",
          "python3 <<'PY'",
          "import os",
          "from pathlib import Path",
          "",
          "path = Path('.env')",
          "lines = [line for line in path.read_text().splitlines()",
          "         if not line.startswith('FE_IMAGE=')]",
          "lines.append('FE_IMAGE=' + os.environ['FE_IMAGE'])",
          "path.write_text('\\n'.join(lines) + '\\n')",
          "PY",
          "",
          "\"${COMPOSE[@]}\" config --quiet",
          "timeout 180 \"${COMPOSE[@]}\" up -d --no-deps frontend",
          "[ \"$(docker inspect planit-frontend-1 --format '{{.Config.Image}}')\" = \"$IMAGE\" ]",
          "",
          "for attempt in $(seq 1 30); do",
          "  if [ \"$(docker exec planit-nginx-1 wget -qO- -T 3 http://frontend:80/healthz 2>/dev/null)\" = ok ] &&",
          "     curl -fsS --max-time 5 https://planit-ai.site/ -o /dev/null; then",
          "    echo \"Frontend deployment and HTTPS check succeeded\"",
          "    echo \"Image: $IMAGE\"",
          "    exit 0",
          "  fi",
          "  sleep 3",
          "done",
          "",
          "echo \"Frontend health check failed. Recovery files: $BACKUP\" >&2",
          "exit 1",
          "BASH"
        ]
      }
    }
  ]
}
